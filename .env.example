# Gmail SMTP — انسخي هذا الملف إلى .env وعبّي القيم
# ملاحظة: لازم App Password من Google (مو كلمة سر الحساب العادية)

MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_ADDRESS=your.email@gmail.com
MAIL_FROM_NAME=Ecommerce Platform

# للتوليد:  openssl rand -hex 32   (أو أي نص عشوائي طويل)
JWT_SECRET=
JWT_ALGO=HS256